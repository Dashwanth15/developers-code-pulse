# ==============================================================================
# DEVELOPERS CODE PULSE (DCP) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Developers Code Pulse"
APP_VERSION="0.1.0"
API_V1_STR=/api/v1

# Networking & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security & CORS
# In production, specify exact allowed origins separated by commas
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]
SECRET_KEY=change_this_to_a_secure_random_string_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=dcp_user
POSTGRES_PASSWORD=dcp_password
POSTGRES_HOST=dcp-db
POSTGRES_PORT=5432
POSTGRES_DB=dcp_db
# Async connection URL used by FastAPI & asyncpg
DATABASE_URL=postgresql+asyncpg://dcp_user:dcp_password@dcp-db:5432/dcp_db
# Sync connection URL used by Alembic migrations
SYNC_DATABASE_URL=postgresql://dcp_user:dcp_password@dcp-db:5432/dcp_db

# Redis & Celery Configuration (Redis 7.2)
REDIS_HOST=dcp-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://dcp-redis:6379/0
CELERY_BROKER_URL=redis://dcp-redis:6379/0
CELERY_RESULT_BACKEND=redis://dcp-redis:6379/0

# GitHub App Configuration (Placeholders for Future Phase 2)
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_WEBHOOK_SECRET=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI Insights Configuration (Optional - Future Phase 8)
# AI_PROVIDER=anthropic
# AI_API_KEY=
