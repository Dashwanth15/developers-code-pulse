# ==============================================================================
# DEVELOPERS CODE PULSE (DCP) — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# SECURITY NOTICE: Never commit .env with real credentials to version control.
# Generate strong secrets using: `openssl rand -hex 32`
# ==============================================================================

# Application Environment & Core
ENVIRONMENT=production
DEBUG=false
APP_NAME="Developers Code Pulse"
APP_VERSION="0.1.0"
API_V1_STR=/api/v1

# Server & Network Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8080
GUNICORN_WORKERS=4

# Security, JWT & CORS
# In production, set CORS_ORIGINS to your exact public frontend domain
CORS_ORIGINS=["https://dcp.yourdomain.com"]
SECRET_KEY=generate_min_32_char_cryptographically_secure_random_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=dcp_user
POSTGRES_PASSWORD=generate_strong_database_password_here
POSTGRES_HOST=dcp-db
POSTGRES_PORT=5432
POSTGRES_DB=dcp_db
DATABASE_URL=postgresql+asyncpg://dcp_user:generate_strong_database_password_here@dcp-db:5432/dcp_db
SYNC_DATABASE_URL=postgresql://dcp_user:generate_strong_database_password_here@dcp-db:5432/dcp_db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30

# Redis & Celery Background Queue (Redis 7.2)
REDIS_PASSWORD=generate_strong_redis_password_here
REDIS_HOST=dcp-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://:generate_strong_redis_password_here@dcp-redis:6379/0
CELERY_BROKER_URL=redis://:generate_strong_redis_password_here@dcp-redis:6379/0
CELERY_RESULT_BACKEND=redis://:generate_strong_redis_password_here@dcp-redis:6379/0

# GitHub App Integration
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# AI Provider Integration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
REPORTS_STORAGE_PATH=storage/reports

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Observability (Prometheus & Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_strong_grafana_password_here
