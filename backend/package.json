{
  "name": "developers-code-pulse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Developers Code Pulse - Python FastAPI Backend Service",
  "scripts": {
    "dev": "py -m uvicorn app.main:app --reload --port 8000",
    "start": "py -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "py -m pytest tests -q",
    "lint": "py -m ruff check app tests",
    "worker": "py -m celery -A app.workers.celery_app worker --loglevel=info"
  }
}
