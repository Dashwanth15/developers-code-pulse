{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Health & Throughput",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "title": "HTTP Request Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(dcp_http_requests_total[1m])) by (method, status_code)",
          "legendFormat": "{{method}} {{status_code}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "title": "HTTP Latency Quantiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(dcp_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Median Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(dcp_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(dcp_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Tail Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Infrastructure & Queue Reliability",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DISCONNECTED" }, "1": { "color": "green", "text": "CONNECTED" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "id": 5,
      "title": "PostgreSQL Connectivity",
      "type": "stat",
      "targets": [{ "expr": "dcp_db_connection_status" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DISCONNECTED" }, "1": { "color": "green", "text": "CONNECTED" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "id": 6,
      "title": "Redis Connectivity",
      "type": "stat",
      "targets": [{ "expr": "dcp_redis_connection_status" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "title": "Celery Task Executions by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(dcp_celery_tasks_total[5m])) by (task_name, status)",
          "legendFormat": "{{task_name}} [{{status}}]"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["dcp", "production", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "DCP Production Engineering Overview",
  "uid": "dcp-prod-overview",
  "version": 1
}
